{
  "name": "monthly-report-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "NODE_ENV=development nest start --watch",
    "dev:client": "NODE_ENV=development vite --config vite.config.ts",
    "build:server": "NODE_ENV=production nest build",
    "build:client": "NODE_ENV=production vite build --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "start": "NODE_ENV=production node dist/server/main.js",
    "db:init": "psql -d $DATABASE_URL -f migrations/001_init.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.15",
    "dotenv": "^17.2.2",
    "drizzle-orm": "0.44.6",
    "postgres": "^3.4.4",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "lucide-react": "^0.554.0",
    "clsx": "~2.0.1",
    "tailwind-merge": "~3.4.0",
    "class-variance-authority": "^0.7.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-toast": "^1.2.8",
    "sonner": "^2.0.7",
    "recharts": "^2.15.4",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/express": "^5.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "ts-node": "^10.9.2",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
